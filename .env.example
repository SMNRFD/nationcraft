# ====================================================================
# NationCraft environment configuration
# Copy to .env and adjust values for your deployment.
#
# This file defaults to LOCAL DEV (no Docker, SQLite, localhost).
# For Docker Compose production deployment, see .env.docker.example.
# ====================================================================

# ---- Runtime ----
ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console
SECRET_KEY=change-me-to-a-32-byte-random-hex-string
JWT_ISSUER=nationcraft
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2

# ---- Database ----
# Local dev (file-based SQLite — created automatically by `python main.py --initdb`):
DATABASE_URL=sqlite+aiosqlite:///nationcraft.db
# Production (PostgreSQL):
#   DATABASE_URL=postgresql+asyncpg://nationcraft:nationcraft@localhost:5432/nationcraft
# In-memory SQLite (tests only — schema not persisted across requests):
#   DATABASE_URL=sqlite+aiosqlite:///:memory:
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---- Redis ----
# Local dev (if you don't have Redis, this is optional — rate limiting falls back to in-memory):
REDIS_URL=redis://localhost:6379/0
# Production:
#   REDIS_URL=redis://localhost:6379/0

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1
# When running `python main.py` (all-in-one), the bot calls the API at localhost:
API_BASE_URL=http://localhost:8000
# When running via docker-compose, use the service name instead:
#   API_BASE_URL=http://api:8000

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_IDS=
TELEGRAM_API_BASE=https://api.telegram.org
# Proxy for the Telegram bot (essential in regions where api.telegram.org
# is blocked/throttled, e.g. Iran/China/Russia). Format:
#   http://host:port   (HTTP proxy)
#   socks5://host:port (SOCKS5 proxy — requires `pip install aiohttp[socks]`)
# Leave empty to connect directly.
# TELEGRAM_PROXY=socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# ---- Game ----
TICK_INTERVAL_SECONDS=60
WORLD_PLAYER_CAPACITY=200
WORLD_AUTO_CREATE=true
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,fa

# ---- Plugin system ----
PLUGINS_ENABLED=true
PLUGINS_DIRS=plugins

# ---- Rate limiting ----
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=300
RATE_LIMIT_BOT_PER_USER_PER_MINUTE=120

# ---- Backups ----
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
